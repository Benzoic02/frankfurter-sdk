{
  "name": "@voxgig-sdk/frankfurter-sdk",
  "version": "0.0.1",
  "description": "Unofficial generated TypeScript SDK for the Frankfurter public API. Not affiliated with or endorsed by the upstream API provider.",
  "keywords": [
    "voxgig",
    "sdk",
    "generated-sdk",
    "openapi",
    "api-client",
    "frankfurter"
  ],
  "homepage": "https://github.com/Benzoic02/frankfurter-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Benzoic02/frankfurter-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Benzoic02/frankfurter-sdk/issues"
  },
  "main": "dist/FrankfurterSDK.js",
  "type": "commonjs",
  "types": "dist/FrankfurterSDK.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "pretest": "npm run build",
    "test": "node --enable-source-maps --test-concurrency=1 --test \"dist-test/**/*.test.js\"",
    "test-some": "node --enable-source-maps --experimental-test-isolation=none --test-name-pattern=\"$TEST_PATTERN\" --test \"dist-test/**/*.test.js\"",
    "test-utility": "node --enable-source-maps --test test/utility/*.test.ts",
    "pretest-coverage": "npm run build",
    "test-coverage": "node --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude='**/dist-test/**' --test-coverage-lines=85 --test-coverage-branches=68 --test-coverage-functions=88 --test \"dist-test/**/*.test.js\"",
    "watch": "tsc --build src test -w",
    "build": "node -e \"const fs = require('node:fs'); for (const path of ['dist', 'dist-test']) fs.rmSync(path, { recursive: true, force: true })\" && tsc --build --force src test",
    "clean": "node -e \"const fs = require('node:fs'); for (const path of ['node_modules', 'yarn.lock', 'package-lock.json', 'dist', 'dist-test']) fs.rmSync(path, { recursive: true, force: true })\"",
    "reset": "npm run clean && npm i && npm run build && npm test"
  },
  "author": {
    "name": "Sushant Babbar",
    "url": "https://github.com/Benzoic02"
  },
  "license": "MIT",
  "dependencies": {},
  "peerDependencies": {},
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.9.3"
  }
}
